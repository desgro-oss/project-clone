# Системные файлы macOS: Finder сам создаёт .DS_Store в каждой открытой папке
# (вид папки, расположение значков). Проекту и репозиторию они не нужны.
.DS_Store

# Состояние агента: журнал прогонов (runs/) и снимок гейта. Пишется каждым
# прогоном гейта и сторожей; в git ему не место — иначе после разреза на
# репозитории подмодуль харнеса грязнел бы после каждой проверки. Путь задаёт
# project.json → state (реструктуризация, шаг Ш4).
.agent-state/*
!.agent-state/README.md

# Локальное машины, не репозиторий: конфиг стороннего инструмента разработки
# и рабочие файлы (записи экрана и т. п.). Сторож нейтральности их не читает —
# игнор-лист project.json → vendorScan.ignore (решение владельца 25.09.2026).
.zcodeignore
tmp/

# Данные сессий CLI ZCode (журналы rollout, кэш, визуализации) — локальные,
# репозиторию не нужны. Читатель затрат смотрит их по домашнему каталогу
# (task-cost, источник zcode, RE0046), в git им места нет.
.zcode/

# Локальный vault Obsidian: настройки графа, панелей и закреплённых заметок.
.obsidian/

# Локальные справочные материалы автора: живут только на его машине,
# в репозиторий не попадают.
/refs/
